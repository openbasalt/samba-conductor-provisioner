# conductor-provisioner: the delegated AD account for conductor. Serves
# conductor only (SO_PEERCRED) on the socket of
# conductor-provisioner-api.socket: one-time invitation and reset tokens,
# password set, lockout clear, account enable, inside the configured OUs
# and never on a privileged account. Every change is audited.
[Unit]
Description=Samba Conductor provisioner: delegated AD writes for conductor
Documentation=https://github.com/openbasalt/samba-conductor-provisioner
Requires=conductor-provisioner-api.socket
After=network-online.target conductor-provisioner-api.socket
Wants=network-online.target

[Service]
Type=simple
User=conductor-provisioner
Group=conductor-provisioner
ExecStart=/usr/local/bin/conductor-provisioner serve --config /etc/conductor-provisioner/provisioner.toml
Restart=on-failure
RestartSec=5s

# The delegated account's password and the state key (keys the audit
# chain), readable only by this service (docs/install.md).
LoadCredential=account-password:/etc/conductor-provisioner/credentials/account-password
LoadCredential=state-key:/etc/conductor-provisioner/credentials/state-key

StateDirectory=conductor-provisioner
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# PrivateUsers stays off: with a private user namespace the peer of every
# connection would read as "nobody" and the SO_PEERCRED check (only the
# conductor user) would refuse conductor.
PrivateUsers=no
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/etc/conductor-provisioner
InaccessiblePaths=-/etc/conductor-provisioner/credentials

[Install]
WantedBy=multi-user.target
